# Copy to .env and adjust. Loaded automatically by `npm start` (Node --env-file-if-exists).
PORT=8085
MONGO_URL=mongodb://localhost:27017
DB_NAME=messagesDB

# The frontend is served by this server, so cross-origin socket access is off by
# default. Uncomment to allow a frontend hosted on another origin ("*" for any).
# CORS_ORIGIN=http://localhost:3000
