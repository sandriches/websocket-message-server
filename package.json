{
  "name": "websocket-message-server",
  "version": "1.0.0",
  "description": "Express + Socket.IO server that stores key/value messages in MongoDB and serves them over HTTP",
  "main": "server/index.js",
  "private": true,
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "mocha",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "express": "^5.1.0",
    "mongodb": "^6.17.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "eslint": "^9.30.0",
    "globals": "^16.3.0",
    "mocha": "^11.7.0",
    "mongodb-memory-server": "^10.1.4",
    "prettier": "^3.6.0",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.1.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sandriches/websocket-message-server.git"
  },
  "author": "Richard Corke",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/sandriches/websocket-message-server/issues"
  },
  "homepage": "https://github.com/sandriches/websocket-message-server#readme"
}
