{
  "name": "websocket-message-server",
  "version": "1.0.0",
  "description": "Express + Socket.IO server that stores key/value messages in MongoDB and serves them over HTTP",
  "main": "server/index.js",
  "private": true,
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "mocha --recursive --exit test"
  },
  "dependencies": {
    "express": "^4.21.2",
    "mongodb": "^6.17.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "chai": "^4.5.0",
    "mocha": "^10.8.2",
    "mongodb-memory-server": "^10.1.4",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.1.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sandriches/websocket-message-server.git"
  },
  "author": "Richard Corke",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/sandriches/websocket-message-server/issues"
  },
  "homepage": "https://github.com/sandriches/websocket-message-server#readme"
}
